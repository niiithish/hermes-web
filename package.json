{
  "name": "hermes-control-interface",
  "version": "3.5.1",
  "description": "Self-hosted web dashboard for the Hermes AI agent stack",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run server.js",
    "dev": "next dev",
    "dev:server": "bun run server.js",
    "dev:all": "concurrently \"bun run server.js\" \"next dev\"",
    "build": "next build",
    "start:next": "next start",
    "setup": "bash install.sh",
    "test": "bun test",
    "reset-password": "bun run scripts/reset-password.js"
  },
  "dependencies": {
    "@pydantic/genai-prices": "^0.0.56",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "multer": "^2.1.1",
    "next": "^16.2.6",
    "node-pty": "^1.1.0",
    "react": "^19",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19",
    "ws": "^8.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
